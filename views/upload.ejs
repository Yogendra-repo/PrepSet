<%- include('partials/header', { title: 'Upload Questions' }) %>
<%- include('partials/navbar', { activePage: 'dashboard' }) %>

<main class="main-content">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-7">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/sets/<%= questionSet.id %>"><%= questionSet.name %></a></li>
            <li class="breadcrumb-item active">Upload CSV</li>
          </ol>
        </nav>

        <%- include('partials/flash') %>

        <!-- Question Set Badge -->
        <div class="d-flex align-items-center gap-2 mb-4">
          <span class="badge bg-primary-soft text-primary px-3 py-2 fs-6">
            <i class="bi bi-journal-bookmark-fill me-1"></i><%= questionSet.name %>
          </span>
        </div>

        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
              <div class="form-page-icon mb-3">
                <i class="bi bi-file-earmark-spreadsheet"></i>
              </div>
              <h2 class="fw-bold mb-1">Upload Questions</h2>
              <p class="text-muted">Upload a CSV file containing your MCQ questions.</p>
            </div>

            <form action="/sets/<%= questionSet.id %>/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
              <div class="mb-4">
                <label for="csvFile" class="form-label fw-semibold">Choose CSV File <span class="text-danger">*</span></label>
                <input
                  type="file"
                  class="form-control form-control-lg"
                  id="csvFile"
                  name="csvFile"
                  accept=".csv"
                  required
                />
                <div class="form-text">Maximum file size: 5MB. Only .csv files accepted.</div>
              </div>

              <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg" id="uploadBtn">
                  <i class="bi bi-cloud-upload-fill me-2"></i>Upload Questions
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- CSV Format Guide -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-transparent border-bottom py-3">
            <h6 class="fw-bold mb-0 d-flex align-items-center gap-2">
              <i class="bi bi-info-circle-fill text-primary"></i>
              Required CSV Format
            </h6>
          </div>
          <div class="card-body p-4">
            <!-- Headers -->
            <p class="fw-semibold mb-2">Required column headers:</p>
            <div class="d-flex flex-wrap gap-2 mb-4">
              <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 font-monospace">question</span>
              <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 font-monospace">optionA</span>
              <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 font-monospace">optionB</span>
              <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 font-monospace">optionC</span>
              <span class="badge bg-secondary-subtle text-secondary border px-3 py-2 font-monospace">optionD</span>
              <span class="badge bg-success-subtle text-success border px-3 py-2 font-monospace">correctAnswer</span>
            </div>

            <!-- correctAnswer note -->
            <div class="alert alert-warning d-flex gap-2 py-2 mb-4 border-0 bg-warning-subtle">
              <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
              <div class="small"><strong>correctAnswer</strong> must be one of: <code>A</code>, <code>B</code>, <code>C</code>, or <code>D</code> (case-insensitive).</div>
            </div>

            <!-- Example -->
            <p class="fw-semibold mb-2">Example CSV:</p>
            <pre class="csv-example p-3 rounded small"><code>question,optionA,optionB,optionC,optionD,correctAnswer
"What is SQL?","A query language","A database","An OS","A protocol","A"
"What is a primary key?","Unique identifier","Duplicate value","Foreign key","Index","A"
"What does DBMS stand for?","Data Base Management System","Digital Base Memory Store","Data Byte Management System","None","A"</code></pre>

            <div class="mt-3">
              <p class="text-muted small mb-0">
                <i class="bi bi-lightbulb me-1"></i>
                <strong>Tip:</strong> Wrap values containing commas in double quotes. Completely empty rows are automatically ignored.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<script>
  // Show loading state on upload
  document.getElementById('uploadForm').addEventListener('submit', function() {
    const btn = document.getElementById('uploadBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Uploading & Validating…';
  });
</script>

<%- include('partials/footer') %>
