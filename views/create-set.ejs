<%- include('partials/header', { title: 'Create Question Set' }) %>
<%- include('partials/navbar', { activePage: 'dashboard' }) %>

<main class="main-content">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Create Question Set</li>
          </ol>
        </nav>

        <%- include('partials/flash') %>

        <div class="card shadow-lg border-0">
          <div class="card-body p-4 p-md-5">
            <!-- Header -->
            <div class="text-center mb-4">
              <div class="form-page-icon mb-3">
                <i class="bi bi-stack"></i>
              </div>
              <h2 class="fw-bold mb-1 text-dark">Create Question Set</h2>
              <p class="text-muted">Give your question bank a title and optional description.</p>
            </div>

            <form action="/sets" method="POST" novalidate>
              <div class="mb-4">
                <label for="name" class="form-label fw-semibold">
                  Question Set Name <span class="text-danger">*</span>
                </label>
                <input
                  type="text"
                  class="form-control form-control-lg"
                  id="name"
                  name="name"
                  placeholder="e.g. DBMS Interview Questions"
                  maxlength="255"
                  required
                  autofocus
                />
                <div class="form-text">Choose a descriptive name for your question bank.</div>
              </div>

              <div class="mb-5">
                <label for="description" class="form-label fw-semibold">
                  Description <span class="text-muted fw-normal">(optional)</span>
                </label>
                <textarea
                  class="form-control"
                  id="description"
                  name="description"
                  rows="3"
                  placeholder="e.g. Important DBMS questions for placement preparation."
                  maxlength="1000"
                ></textarea>
              </div>

              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg">
                  <i class="bi bi-arrow-right-circle-fill me-2"></i>Create Question Set
                </button>
                <a href="/dashboard" class="btn btn-outline-secondary">
                  <i class="bi bi-x me-1"></i>Cancel
                </a>
              </div>
            </form>
          </div>
        </div>

        <!-- Info box -->
        <div class="alert alert-info d-flex gap-2 mt-4 border-0 bg-info-subtle" role="alert">
          <i class="bi bi-lightbulb-fill flex-shrink-0 mt-1"></i>
          <div>
            <strong>Next Step:</strong> After creating the set, you'll be taken to the CSV upload page where you can import your questions.
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
