<%- include('partials/header', { title: 'Dashboard' }) %>
<%- include('partials/navbar', { activePage: 'dashboard' }) %>

<main class="main-content">
  <div class="container py-5">
    <%- include('partials/flash') %>

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-5">
      <div>
        <h1 class="fw-bold mb-1">Your Question Sets</h1>
        <p class="text-muted mb-0">
          <% if (questionSets.length > 0) { %>
            <%= questionSets.length %> set<%= questionSets.length !== 1 ? 's' : '' %> available
          <% } else { %>
            Get started by creating your first question set
          <% } %>
        </p>
      </div>
      <a href="/sets/new" class="btn btn-primary btn-lg d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Create New Set
      </a>
    </div>

    <% if (questionSets.length === 0) { %>
      <!-- Empty State -->
      <div class="empty-state text-center py-5">
        <div class="empty-state-icon mb-4">
          <i class="bi bi-journal-plus"></i>
        </div>
        <h3 class="fw-semibold mb-2">No Question Sets Yet</h3>
        <p class="text-muted mb-4 mx-auto" style="max-width: 400px;">
          Create your first question set and upload a CSV file to start quizzing yourself.
        </p>
        <a href="/sets/new" class="btn btn-primary btn-lg px-5">
          <i class="bi bi-plus-lg me-2"></i>Create Your First Set
        </a>
      </div>
    <% } else { %>
      <!-- Question Set Cards -->
      <div class="row g-4">
        <% questionSets.forEach(set => { %>
          <div class="col-12 col-md-6 col-xl-4">
            <div class="card question-set-card h-100 shadow-sm border-0">
              <div class="card-body d-flex flex-column p-4">
                <!-- Card Header -->
                <div class="d-flex align-items-start justify-content-between mb-3">
                  <div class="set-icon-wrap me-3">
                    <i class="bi bi-journal-bookmark-fill"></i>
                  </div>
                  <span class="badge bg-primary-soft text-primary fw-semibold ms-auto">
                    <%= set.question_count %> Q<%= set.question_count != 1 ? 's' : '' %>
                  </span>
                </div>

                <!-- Card Content -->
                <h5 class="card-title fw-bold mb-2"><%= set.name %></h5>
                <p class="card-text text-muted small flex-grow-1">
                  <% if (set.description) { %>
                    <%= set.description.length > 100 ? set.description.substring(0, 100) + '…' : set.description %>
                  <% } else { %>
                    <em>No description provided.</em>
                  <% } %>
                </p>

                <!-- Created date -->
                <p class="text-muted small mb-3 mt-2">
                  <i class="bi bi-calendar3 me-1"></i>
                  Created <%= new Date(set.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </p>

                <!-- Actions -->
                <div class="d-flex gap-2 mt-auto">
                  <% if (set.question_count > 0) { %>
                    <a href="/sets/<%= set.id %>/quiz" class="btn btn-primary flex-grow-1">
                      <i class="bi bi-play-fill me-1"></i>Start Quiz
                    </a>
                  <% } else { %>
                    <a href="/sets/<%= set.id %>/upload" class="btn btn-warning flex-grow-1">
                      <i class="bi bi-upload me-1"></i>Upload CSV
                    </a>
                  <% } %>
                  <a href="/sets/<%= set.id %>" class="btn btn-outline-secondary">
                    <i class="bi bi-gear-fill"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>

        <!-- Create New Set card -->
        <div class="col-12 col-md-6 col-xl-4">
          <a href="/sets/new" class="text-decoration-none">
            <div class="card create-set-card h-100 border-dashed d-flex align-items-center justify-content-center" style="min-height: 220px;">
              <div class="card-body text-center p-4">
                <div class="create-set-icon mb-3">
                  <i class="bi bi-plus-circle-fill"></i>
                </div>
                <h6 class="fw-semibold text-muted">Create New Set</h6>
                <p class="text-muted small mb-0">Add a new question bank</p>
              </div>
            </div>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
