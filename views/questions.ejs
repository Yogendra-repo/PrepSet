<%- include('partials/header', { title: questionSet.name }) %>
<%- include('partials/navbar', { activePage: 'dashboard' }) %>

<main class="main-content">
  <div class="container py-5">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item active"><%= questionSet.name %></li>
      </ol>
    </nav>

    <%- include('partials/flash') %>

    <!-- Set Header -->
    <div class="card border-0 mb-4 p-4 shadow-sm" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(14px);">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="brand-icon-badge" style="width: 32px; height: 32px; font-size: 1rem;"><i class="bi bi-stack"></i></span>
            <h1 class="fw-bold mb-0 text-dark" style="font-size: 1.8rem;"><%= questionSet.name %></h1>
          </div>
          <% if (questionSet.description) { %>
            <p class="text-muted mb-3 mt-1"><%= questionSet.description %></p>
          <% } else { %>
            <div class="mb-2"></div>
          <% } %>
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="badge-count">
              <i class="bi bi-question-circle me-1"></i><%= questions.length %> Question<%= questions.length !== 1 ? 's' : '' %>
            </span>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
              <i class="bi bi-star-fill me-1"></i><span id="flaggedTotalCount"><%= questions.filter(q => q.is_flagged).length %></span> Flagged
            </span>
            <span class="text-muted small">
              <i class="bi bi-calendar3 me-1"></i>
              Created <%= new Date(questionSet.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
            </span>
          </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/sets/<%= questionSet.id %>/upload" class="btn btn-outline-secondary">
            <i class="bi bi-upload me-1"></i>Upload More
          </a>
          <% if (questions.length > 0) { %>
            <a href="/sets/<%= questionSet.id %>/quiz" class="btn btn-primary btn-lg px-4">
              <i class="bi bi-play-fill me-1"></i>Start Quiz
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <% if (questions.length === 0) { %>
      <!-- Empty State -->
      <div class="empty-state-box my-4">
        <div class="empty-state-icon">
          <i class="bi bi-file-earmark-plus"></i>
        </div>
        <h3 class="fw-bold mb-2">No Questions in This Set</h3>
        <p class="text-muted mb-4 mx-auto" style="max-width: 420px;">Upload questions using a CSV file or paste formatted CSV text to begin quizzing.</p>
        <a href="/sets/<%= questionSet.id %>/upload" class="btn btn-primary btn-lg px-5">
          <i class="bi bi-upload me-2"></i>Upload Questions
        </a>
      </div>
    <% } else { %>

      <!-- Recent Attempts -->
      <% if (attempts && attempts.length > 0) { %>
        <div class="card border-0 mb-4">
          <div class="card-header bg-transparent border-bottom py-3">
            <h6 class="fw-bold mb-0 d-flex align-items-center gap-2 text-dark">
              <i class="bi bi-clock-history text-primary"></i>Recent Quiz Attempts
            </h6>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0 align-middle">
                <thead class="table-light small text-muted text-uppercase">
                  <tr>
                    <th class="ps-4">Date & Time</th>
                    <th>Score</th>
                    <th>Accuracy</th>
                    <th>Duration</th>
                  </tr>
                </thead>
                <tbody>
                  <% attempts.forEach(a => { %>
                    <tr>
                      <td class="ps-4 text-muted small">
                        <%= new Date(a.created_at).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                      </td>
                      <td class="fw-bold text-dark"><%= a.score %> / <%= a.total_questions %></td>
                      <td>
                        <% const pct = a.total_questions > 0 ? Math.round((a.score / a.total_questions) * 100) : 0; %>
                        <span class="badge <%= pct >= 75 ? 'bg-success' : pct >= 50 ? 'bg-warning text-dark' : 'bg-danger' %> px-2.5 py-1.5 rounded-pill">
                          <%= pct %>%
                        </span>
                      </td>
                      <td class="text-muted small">
                        <i class="bi bi-stopwatch me-1"></i><%= Math.floor(a.duration_seconds / 60).toString().padStart(2, '0') %>:<%= (a.duration_seconds % 60).toString().padStart(2, '0') %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Questions Header & Live Filter -->
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
        <div class="d-flex align-items-center gap-2">
          <h5 class="fw-bold mb-0 text-white">Questions (<span id="visibleQuestionsCount"><%= questions.length %></span>)</h5>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
          <!-- Filter Buttons -->
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-primary active" id="btnFilterAll" onclick="filterQuestions('all')">All</button>
            <button type="button" class="btn btn-outline-light" id="btnFilterFlagged" onclick="filterQuestions('flagged')">Flagged Only</button>
          </div>

          <!-- Search Input -->
          <div class="search-filter-wrapper py-1 px-2.5" style="max-width: 260px;">
            <i class="bi bi-search text-muted small"></i>
            <input
              type="text"
              id="questionSearchInput"
              placeholder="Search in questions..."
              style="font-size: 0.85rem;"
              oninput="filterQuestions()"
            />
          </div>
        </div>
      </div>

      <div class="d-flex flex-column gap-3" id="questionsList">
        <% questions.forEach((q, idx) => { %>
          <div class="card question-card question-item border-0 shadow-sm <%= q.is_flagged ? 'flagged-card' : '' %>" id="question-<%= q.id %>" data-flagged="<%= q.is_flagged %>" data-text="<%= q.question_text.toLowerCase() %>">
            <div class="card-body p-4">
              <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                <div class="d-flex align-items-start gap-3 flex-grow-1">
                  <span class="question-number-badge flex-shrink-0"><%= idx + 1 %></span>
                  <h6 class="fw-semibold mb-0 lh-base flex-grow-1"><%= q.question_text %></h6>
                </div>
                <% if (q.is_flagged) { %>
                  <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 flex-shrink-0">
                    <i class="bi bi-star-fill me-1"></i>Flagged
                  </span>
                <% } %>
              </div>

              <!-- Options -->
              <div class="row g-2 mb-3 ps-5">
                <div class="col-12 col-md-6">
                  <div class="option-item <%= q.correct_answer === 'A' ? 'correct-option' : '' %>">
                    <span class="option-label">A</span>
                    <span><%= q.option_a %></span>
                    <% if (q.correct_answer === 'A') { %><i class="bi bi-check-circle-fill ms-auto text-success"></i><% } %>
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <div class="option-item <%= q.correct_answer === 'B' ? 'correct-option' : '' %>">
                    <span class="option-label">B</span>
                    <span><%= q.option_b %></span>
                    <% if (q.correct_answer === 'B') { %><i class="bi bi-check-circle-fill ms-auto text-success"></i><% } %>
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <div class="option-item <%= q.correct_answer === 'C' ? 'correct-option' : '' %>">
                    <span class="option-label">C</span>
                    <span><%= q.option_c %></span>
                    <% if (q.correct_answer === 'C') { %><i class="bi bi-check-circle-fill ms-auto text-success"></i><% } %>
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <div class="option-item <%= q.correct_answer === 'D' ? 'correct-option' : '' %>">
                    <span class="option-label">D</span>
                    <span><%= q.option_d %></span>
                    <% if (q.correct_answer === 'D') { %><i class="bi bi-check-circle-fill ms-auto text-success"></i><% } %>
                  </div>
                </div>
              </div>

              <!-- Flag button -->
              <div class="d-flex align-items-center justify-content-between ps-5">
                <span class="text-muted small">
                  Correct: <strong class="text-success"><%= q.correct_answer %></strong>
                </span>
                <button
                  class="btn btn-sm flag-btn <%= q.is_flagged ? 'btn-warning' : 'btn-outline-secondary' %>"
                  data-question-id="<%= q.id %>"
                  data-flagged="<%= q.is_flagged %>"
                >
                  <i class="bi <%= q.is_flagged ? 'bi-star-fill' : 'bi-star' %> me-1"></i>
                  <%= q.is_flagged ? 'Unflag' : 'Flag Important' %>
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Bottom Action -->
      <div class="text-center mt-5">
        <a href="/sets/<%= questionSet.id %>/quiz" class="btn btn-primary btn-lg px-5">
          <i class="bi bi-play-fill me-2"></i>Start Quiz
        </a>
      </div>

      <!-- Danger Zone -->
      <div class="card border-danger border-opacity-25 mt-5">
        <div class="card-body p-4">
          <h6 class="text-danger fw-bold mb-1">Danger Zone</h6>
          <p class="text-muted small mb-3">Deleting this question set will permanently remove all questions and quiz history.</p>
          <form action="/sets/<%= questionSet.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this question set? This cannot be undone.')">
            <button type="submit" class="btn btn-outline-danger btn-sm">
              <i class="bi bi-trash3 me-1"></i>Delete Question Set
            </button>
          </form>
        </div>
      </div>

    <% } %>
  </div>
</main>

<script>
  let currentFlagFilter = 'all';

  function filterQuestions(flagType) {
    if (flagType) {
      currentFlagFilter = flagType;
      const allBtn = document.getElementById('btnFilterAll');
      const flaggedBtn = document.getElementById('btnFilterFlagged');
      if (allBtn && flaggedBtn) {
        if (flagType === 'all') {
          allBtn.className = 'btn btn-primary active';
          flaggedBtn.className = 'btn btn-outline-light';
        } else {
          allBtn.className = 'btn btn-outline-light';
          flaggedBtn.className = 'btn btn-primary active';
        }
      }
    }

    const query = (document.getElementById('questionSearchInput')?.value || '').toLowerCase().trim();
    let visible = 0;

    document.querySelectorAll('.question-item').forEach(card => {
      const isFlagged = card.getAttribute('data-flagged') === 'true';
      const text = card.getAttribute('data-text') || '';

      const matchFlag = (currentFlagFilter === 'all') || (currentFlagFilter === 'flagged' && isFlagged);
      const matchText = !query || text.includes(query);

      if (matchFlag && matchText) {
        card.classList.remove('d-none');
        visible++;
      } else {
        card.classList.add('d-none');
      }
    });

    const countEl = document.getElementById('visibleQuestionsCount');
    if (countEl) countEl.textContent = visible;
  }
</script>

<%- include('partials/footer') %>
