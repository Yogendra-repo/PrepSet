<%- include('partials/header', { title: 'Quiz — ' + questionSet.name }) %>
<%- include('partials/navbar', { activePage: '' }) %>

<main class="main-content quiz-mode">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">

        <!-- Quiz Header -->
        <div class="quiz-header-card shadow-sm mb-4">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
              <span class="brand-icon-badge" style="width: 28px; height: 28px; font-size: 0.85rem;"><i class="bi bi-stack"></i></span>
              <span class="text-white fw-bold"><%= questionSet.name %></span>
            </div>
            <div class="d-flex align-items-center gap-3">
              <span class="text-white-50 small" id="answeredLabel">0 answered</span>
              <span class="badge bg-primary px-3 py-1.5 rounded-pill shadow-sm" aria-label="Elapsed time">
                <i class="bi bi-stopwatch me-1"></i><span id="quizTimer">00:00</span>
              </span>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="quiz-progress-wrap">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
              <span class="text-white-50 small" id="progressLabel">Question 1 of <%= questions.length %></span>
              <span class="text-white-50 small" id="progressPercent">0%</span>
            </div>
            <div class="progress quiz-progress">
              <div class="progress-bar" id="progressBar" role="progressbar" style="width: 0%"></div>
            </div>
          </div>
        </div>

        <!-- Questions Form -->
        <form id="quizForm" action="/sets/<%= questionSet.id %>/quiz/submit" method="POST">
          <input type="hidden" name="attemptToken" value="<%= attemptToken %>" />

          <% questions.forEach((q, idx) => { %>
            <div class="quiz-question-slide card quiz-container-card border-0 shadow-lg <%= idx === 0 ? 'active' : '' %>" id="slide-<%= idx %>" data-index="<%= idx %>">
              <div class="card-body p-4 p-md-5">

                <!-- Question top status -->
                <div class="d-flex align-items-center gap-2 mb-4">
                  <span class="quiz-q-badge"><%= idx + 1 %></span>
                  <span class="text-muted small">of <%= questions.length %> questions</span>
                  <span class="ms-auto badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill" id="answered-badge-<%= idx %>">Not answered</span>
                </div>

                <!-- Question text -->
                <h4 class="fw-bold lh-base mb-4 text-dark"><%= q.question_text %></h4>

                <!-- Options -->
                <div class="d-flex flex-column gap-3">
                  <% const opts = [
                    { key: 'A', val: q.option_a },
                    { key: 'B', val: q.option_b },
                    { key: 'C', val: q.option_c },
                    { key: 'D', val: q.option_d },
                  ]; %>
                  <% opts.forEach(opt => { %>
                    <label class="quiz-option-label" id="opt-<%= idx %>-<%= opt.key %>">
                      <input
                        type="radio"
                        name="answers[q_<%= q.id %>]"
                        value="<%= opt.key %>"
                        class="quiz-radio"
                        data-slide="<%= idx %>"
                        data-key="<%= opt.key %>"
                      />
                      <span class="quiz-option-key"><%= opt.key %></span>
                      <span class="quiz-option-text"><%= opt.val %></span>
                    </label>
                  <% }) %>
                </div>

              </div>
            </div>
          <% }) %>

          <!-- Navigation Controls -->
          <div class="quiz-nav d-flex align-items-center justify-content-between mt-4 gap-3">
            <button type="button" class="btn btn-outline-light btn-lg px-4" id="prevBtn" disabled onclick="navigate(-1)">
              <i class="bi bi-arrow-left me-1"></i>Previous
            </button>

            <!-- Question dots (desktop) -->
            <div class="quiz-dots d-none d-md-flex gap-1.5 flex-wrap justify-content-center">
              <% questions.forEach((_, idx) => { %>
                <button type="button" class="dot-btn" id="dot-<%= idx %>" onclick="goToSlide(<%= idx %>)" title="Question <%= idx + 1 %>"></button>
              <% }) %>
            </div>

            <button type="button" class="btn btn-primary btn-lg px-4" id="nextBtn" onclick="navigate(1)">
              Next<i class="bi bi-arrow-right ms-1"></i>
            </button>
          </div>

          <!-- Submit Button (shown on last question) -->
          <div class="text-center mt-4" id="submitWrap" style="display: none !important;">
            <button type="button" class="btn btn-success btn-lg px-5 shadow-lg" id="submitBtn" onclick="confirmSubmit()">
              <i class="bi bi-check2-circle me-2"></i>Submit Quiz
            </button>
            <p class="text-muted small mt-2" id="unansweredWarning" style="display: none;">
              <i class="bi bi-exclamation-triangle me-1 text-warning"></i>
              <span id="unansweredCount"></span> question(s) left unanswered.
            </p>
          </div>

          <!-- Keyboard Shortcuts Hint -->
          <div class="text-center mt-3 text-white-50 small">
            <i class="bi bi-keyboard me-1"></i>Press <kbd class="bg-dark text-white border border-secondary px-1 rounded">A</kbd>–<kbd class="bg-dark text-white border border-secondary px-1 rounded">D</kbd> to pick answer &bull; <kbd class="bg-dark text-white border border-secondary px-1 rounded">&larr;</kbd> <kbd class="bg-dark text-white border border-secondary px-1 rounded">&rarr;</kbd> to navigate
          </div>

        </form>

      </div>
    </div>
  </div>
</main>

<script>
  const TOTAL = <%= questions.length %>;
  let current = 0;
  const answered = new Array(TOTAL).fill(false);
  const quizStartedAt = Date.now();

  function updateTimer() {
    const elapsedSeconds = Math.floor((Date.now() - quizStartedAt) / 1000);
    const minutes = Math.floor(elapsedSeconds / 60).toString().padStart(2, '0');
    const seconds = (elapsedSeconds % 60).toString().padStart(2, '0');
    document.getElementById('quizTimer').textContent = `${minutes}:${seconds}`;
  }

  function updateUI() {
    // Show/hide slides
    document.querySelectorAll('.quiz-question-slide').forEach((el, i) => {
      el.classList.toggle('active', i === current);
    });

    // Progress
    document.getElementById('progressLabel').textContent = `Question ${current + 1} of ${TOTAL}`;
    const answeredCount = answered.filter(Boolean).length;
    document.getElementById('answeredLabel').textContent = `${answeredCount} answered`;
    const pct = Math.round((answeredCount / TOTAL) * 100);
    document.getElementById('progressBar').style.width = `${pct}%`;
    const pctLabel = document.getElementById('progressPercent');
    if (pctLabel) pctLabel.textContent = `${pct}%`;

    // Nav buttons
    document.getElementById('prevBtn').disabled = current === 0;
    const nextBtn = document.getElementById('nextBtn');

    // Dots
    document.querySelectorAll('.dot-btn').forEach((d, i) => {
      d.classList.toggle('active', i === current);
      d.classList.toggle('answered', answered[i]);
    });

    // Submit button: show on last slide or toggle
    const submitWrap = document.getElementById('submitWrap');
    if (current === TOTAL - 1) {
      submitWrap.style.removeProperty('display');
      nextBtn.style.display = 'none';
    } else {
      submitWrap.style.setProperty('display', 'none', 'important');
      nextBtn.style.display = '';
    }
  }

  function navigate(dir) {
    const next = current + dir;
    if (next >= 0 && next < TOTAL) {
      current = next;
      updateUI();
    }
  }

  function goToSlide(idx) {
    current = idx;
    updateUI();
  }

  function confirmSubmit() {
    const unanswered = document.querySelectorAll('.quiz-question-slide').length -
      document.querySelectorAll('.quiz-radio:checked').length;
    if (unanswered > 0) {
      const warn = document.getElementById('unansweredWarning');
      document.getElementById('unansweredCount').textContent = unanswered;
      warn.style.display = 'block';
      if (!confirm(`You have ${unanswered} unanswered question(s). Are you sure you want to submit?`)) return;
    }
    document.getElementById('quizForm').submit();
  }

  // Listen for radio changes
  document.querySelectorAll('.quiz-radio').forEach(radio => {
    radio.addEventListener('change', function() {
      const idx = parseInt(this.dataset.slide);
      answered[idx] = true;

      // Update option styles for this slide
      document.querySelectorAll(`[id^="opt-${idx}-"]`).forEach(label => {
        label.classList.remove('selected');
      });
      document.getElementById(`opt-${idx}-${this.dataset.key}`).classList.add('selected');

      // Update answered badge
      const badge = document.getElementById(`answered-badge-${idx}`);
      badge.textContent = `Option ${this.dataset.key} selected`;
      badge.className = 'ms-auto badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill';

      updateUI();
    });
  });

  // Keyboard navigation support
  document.addEventListener('keydown', function(e) {
    // If typing in an input or textarea, ignore
    if (['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return;

    const key = e.key.toUpperCase();
    // A, B, C, D to pick option
    if (['A', 'B', 'C', 'D'].includes(key)) {
      const radio = document.querySelector(`.quiz-question-slide.active .quiz-radio[data-key="${key}"]`);
      if (radio) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change'));
      }
    } else if (e.key === 'ArrowLeft') {
      navigate(-1);
    } else if (e.key === 'ArrowRight') {
      navigate(1);
    } else if (e.key === 'Enter' && current === TOTAL - 1) {
      confirmSubmit();
    }
  });

  // Init
  updateUI();
  updateTimer();
  const timerInterval = setInterval(updateTimer, 1000);
  document.getElementById('quizForm').addEventListener('submit', () => clearInterval(timerInterval));
</script>

<%- include('partials/footer') %>
