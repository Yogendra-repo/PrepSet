<%- include('partials/header', { title: 'Create Account' }) %>

<main class="main-content auth-page">
  <div class="container py-5">
    <div class="auth-shell">
      <div class="auth-brand mb-4">
        <span class="brand-icon-badge"><i class="bi bi-stack"></i></span>
        <span style="color:white;">Prep<span style="color: #38bdf8;">Set</span></span>
      </div>

      <div class="card auth-card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <h1 class="fw-bold text-dark mb-2">Create your account</h1>
            <p class="text-muted mb-0">Your question sets and quiz history stay private.</p>
          </div>

          <%- include('partials/flash') %>

          <form action="/signup" method="POST">
            <div class="mb-3">
              <label for="displayName" class="form-label fw-semibold">Display name</label>
              <input type="text" class="form-control form-control-lg" id="displayName" name="displayName" value="<%= formData.displayName %>" maxlength="80" autocomplete="name" required autofocus>
            </div>
            <div class="mb-3">
              <label for="email" class="form-label fw-semibold">Email address</label>
              <input type="email" class="form-control form-control-lg" id="email" name="email" value="<%= formData.email %>" autocomplete="email" required>
            </div>
            <div class="mb-4">
              <label for="password" class="form-label fw-semibold">Password</label>
              <input type="password" class="form-control form-control-lg" id="password" name="password" minlength="8" maxlength="128" autocomplete="new-password" required>
              <div class="form-text">Use at least 8 characters.</div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">
              <i class="bi bi-person-plus-fill me-2"></i>Create Account
            </button>
          </form>

          <p class="text-center text-muted mt-4 mb-0">Already have an account? <a href="/login" class="fw-semibold">Log in</a></p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>